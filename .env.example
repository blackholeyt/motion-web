# Motion Web: example environment. Copy to .env.local (app) or .env.test.local (live RLS test).
# Real values never go into the repo; .gitignore excludes every .env file except this one.

# --- App (public values, built into the frontend; set them as the GitHub secrets SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY as well) ---
# Supabase: Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Live RLS test only (.env.test.local, never in the frontend, never in GitHub) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_...) bypasses Row Level Security. Keep it on your computer only.
SUPABASE_SECRET_KEY=sb_secret_...
